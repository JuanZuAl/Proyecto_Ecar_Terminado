@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthorizationService AuthorizationService
@inject AuthService AuthService
@inject HttpClientService HttpClientService

@using MudBlazor

<MudLayout>
    <MudThemeProvider Theme="TemaEcar.Tema" />
    <MudDialogProvider />
    <MudPopoverProvider />
    <MudSnackbarProvider />
    <VigilanteSesion />

    @* En el login no hay barra ni menú: su tarjeta ya lleva el logo (Fase 5, F-05).
       La barra es clara para que el logo, que ya no lleva fondo, se vea con sus colores. *@
    @if (!EsLogin)
    {
    <MudAppBar Elevation="0" Class="app-bar">
        @if (isAuthenticated)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" title="Menú" />
        }
        <img src="images/logo-ecar.png" alt="ECAR Laboratorios" class="app-bar-logo" />
        <MudSpacer />
        @* En el teléfono quedan solo el avatar y el icono de salir: con el texto, la barra medía más
           de 375 px y ensanchaba todas las páginas. *@
        @if (isAuthenticated)
        {
            @if (!string.IsNullOrWhiteSpace(usuarioNombre))
            {
                <div class="usuario-barra" title="@usuarioNombre">
                    <span class="avatar-usuario" aria-hidden="true">@Iniciales</span>
                    <div class="usuario-datos">
                        <span class="usuario-nombre">@usuarioNombre</span>
                        @if (!string.IsNullOrWhiteSpace(usuarioRol))
                        {
                            <span class="usuario-rol">@usuarioRol</span>
                        }
                    </div>
                </div>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="HandleLogout" title="Cerrar sesión" Class="boton-salir">
                <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" Size="Size.Small" />
                <span class="texto-barra">Cerrar sesión</span>
            </MudButton>
        }
    </MudAppBar>
    }

    @* Sin sesión no hay menú: el login y la consulta del QR no deben mostrar el resto del sistema.
       El cajón se monta siempre (así abre como antes en escritorio) y solo se cierra sin sesión.
       MudNavLink resalta la página en la que se está; «Administración» es un grupo que se despliega,
       no una opción que parezca seleccionada (Fase 5, F-04). *@
    @* En el login el cajón ni se monta: si se llega por una redirección (sesión vencida), el layout ya estaba
       pintado con el menú abierto y se veía cerrarse, con una franja azul vacía y la tarjeta desplazada. *@
    @if (!EsLogin)
    {
    <MudDrawer @bind-Open="drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="sidebar">
        @if (isAuthenticated && !EsLogin)
        {
        <MudNavMenu Class="menu-lateral">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
            <MudNavLink Href="/inspecciones" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">Inspecciones</MudNavLink>
            @* Consulta de equipos para todos los roles; crear y editar sigue siendo del Administrador. *@
            <MudNavLink Href="/equipos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Devices">Equipos</MudNavLink>
            <MudNavLink Href="/evidencias" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PhotoLibrary">Evidencias</MudNavLink>
            @* El Operador no resuelve novedades: las de sus inspecciones las ve en el resultado de cada una. *@
            @if (!soloOperador)
            {
                <MudNavLink Href="/novedades" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReportProblem">Novedades</MudNavLink>
            }
            @* Las preguntas se editan dentro de cada checklist: la pantalla «Preguntas de Checklist» se quitó el 29/10/2026. *@
            <MudNavLink Href="/checklists" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PlaylistAddCheck">Checklists</MudNavLink>
            @if (!soloOperador)
            {
                <MudNavLink Href="/categorias-equipo" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Categoría de Equipos</MudNavLink>
            }
            @* Reportes y auditoría: solo Administrador y Supervisor, igual que el API. *@
            @if (isAdmin || isSupervisor)
            {
                <MudNavLink Href="/auditoria" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">Auditoría</MudNavLink>
                <MudNavLink Href="/reportes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Summarize">Reportes</MudNavLink>
            }

            @if (isAdmin)
            {
                <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.AdminPanelSettings" @bind-Expanded="administracionAbierta">
                    <MudNavLink Href="/ubicaciones" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Place">Ubicaciones</MudNavLink>
                    <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink>
                    @* «Roles» está oculta para todos desde el 29/10/2026: los roles son fijos (RolesSistema). *@
                    <MudNavLink Href="/admin/usuarios-roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Roles de Usuario</MudNavLink>
                </MudNavGroup>
            }

            @* Quiénes desarrollaron el sistema (ECAR.Shared/Creditos): para todos los roles, al final del menú. *@
            <MudNavLink Href="/creditos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups" Class="enlace-creditos">Créditos</MudNavLink>
        </MudNavMenu>
        }
    </MudDrawer>
    }

    @* En el login el contenido ocupa todo el ancho: el fondo de la pantalla no debe quedarse en un contenedor
       de 1280 px, con franjas de otro tono a los lados. *@
    <MudMainContent Class="@(EsLogin ? "main-content sin-barra" : "main-content")">
        <MudContainer MaxWidth="@(EsLogin ? MaxWidth.False : MaxWidth.Large)" Class="content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
/* ---------- Barra superior: el azul de siempre, con el logo en su sello blanco ---------- */
.app-bar {
    background-color: var(--primary) !important;
    color: #FFFFFF;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22) !important;
}

.app-bar .mud-toolbar {
    gap: 8px;
}

/* El logo es un sello circular con su propio fondo blanco: se lee igual sobre el azul. */
.app-bar-logo {
    height: 56px;
    width: 56px;
    object-fit: contain;
    display: block;
    margin-left: 4px;
}

.usuario-barra {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: 4px;
    min-width: 0;
}

.avatar-usuario {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
}

.usuario-datos {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
}

.usuario-nombre {
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 500;
    color: #FFFFFF;
}

.usuario-rol {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.86);
}

.app-bar .boton-salir {
    background-color: transparent;
    color: #FFFFFF !important;
    border-color: rgba(255, 255, 255, 0.6) !important;
}

.app-bar .boton-salir:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

/* ---------- Menú lateral: el azul de siempre; el verde del logo marca la página actual ---------- */
.sidebar {
    background-color: var(--primary-dark) !important;
    border-right: none !important;
    box-shadow: none !important;
    /* El menú no se desplaza a lo ancho: antes medía 238 px en un cajón de 230 y salía una barra horizontal. */
    overflow-x: hidden !important;
}

.menu-lateral {
    padding: 14px 10px;
}

.sidebar .menu-lateral .mud-nav-link {
    color: #FFFFFF !important;
    border-radius: 10px;
    margin: 2px 0;
    padding: 9px 12px;
    width: auto;
    font-weight: 400;
    transition: background-color 0.15s ease;
}

.sidebar .menu-lateral .mud-nav-link .mud-nav-link-icon {
    color: rgba(255, 255, 255, 0.85) !important;
    margin-right: 12px;
    transition: color 0.15s ease;
}

.sidebar .menu-lateral .mud-nav-link .mud-nav-link-expand-icon {
    color: rgba(255, 255, 255, 0.85) !important;
}

.sidebar .menu-lateral .mud-nav-link:hover:not(.mud-nav-link-disabled) {
    background-color: rgba(255, 255, 255, 0.12) !important;
}

/* La página actual: fondo más claro y el icono en el verde del logo (sin barra de color al lado). */
.sidebar .menu-lateral .mud-nav-link.active:not(.mud-nav-link-disabled) {
    background-color: rgba(255, 255, 255, 0.22) !important;
    color: #FFFFFF !important;
    font-weight: 500;
}

.sidebar .menu-lateral .mud-nav-link.active:not(.mud-nav-link-disabled) .mud-nav-link-icon {
    color: #B5E09C !important;
}

.sidebar .menu-lateral .mud-nav-link:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 0;
}

/* «Administración» es un encabezado: separado del resto y sin fondo propio. */
.sidebar .menu-lateral .mud-nav-group {
    margin-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    padding-top: 10px;
}

.sidebar .menu-lateral .mud-nav-group > .mud-nav-link {
    font-weight: 500;
}

/* «Créditos» no es una pantalla de trabajo: va al final, separada del resto. */
.sidebar .menu-lateral .enlace-creditos {
    margin-top: 12px;
}

/* ---------- Contenido ---------- */
.main-content {
    background-color: var(--background);
    min-height: 100vh;
}

/* Sin barra (login) el contenido no necesita el espacio que MudBlazor reserva arriba para ella. El fondo, de
   borde a borde de la pantalla: dos manchas suaves con el azul y el verde del logo. */
.main-content.sin-barra {
    padding-top: 0 !important;
    background:
        radial-gradient(900px 520px at 10% 6%, rgba(57, 127, 222, 0.15), transparent 62%),
        radial-gradient(820px 520px at 94% 98%, rgba(121, 183, 93, 0.18), transparent 60%),
        var(--background);
}

/* El login mide la altura de la pantalla: con el relleno del contenedor sobraban 64 px y se desplazaba. */
.main-content.sin-barra .content {
    padding: 0;
}

.content {
    padding: 28px 32px 40px;
}

/* Las páginas traen su propio MudContainer, con 24 px de margen lateral: sumado al del layout, cada página
   quedaba a una distancia distinta del borde (Tablero 64 px, el resto 56 px). Aquí todas alinean con el layout. */
.content .mud-container {
    padding-left: 0;
    padding-right: 0;
}

@@media (max-width: 959.98px) {
    .content {
        padding: 20px 16px 32px;
    }

    .usuario-datos {
        display: none;
    }
}

/* Teléfono (por debajo de 600 px, donde MudBlazor apila las tablas). */
@@media (max-width: 599.98px) {
    .texto-barra {
        display: none;
    }

    .app-bar .mr-2 {
        margin-right: 0 !important;
    }

    .app-bar-logo {
        height: 46px;
        width: 46px;
    }

    .content {
        padding: 1rem 0.5rem;
    }

    /* El botón "Nuevo …" de la cabecera de cada tarjeta baja de línea en vez de salirse. */
    .mud-card-header {
        flex-wrap: wrap;
    }

    .mud-card-header .mud-card-header-actions {
        margin-top: 0.5rem;
    }
}
</style>

@code {
    private bool drawerOpen = true;
    private bool administracionAbierta = true;

    // El layout se vuelve a pintar en cada navegación (cambia Body), así que basta con leer la ruta aquí.
    // El login y las pantallas que abre cuando SGI.Identity lo pide (cambiar la contraseña, activar la cuenta).
    private bool EsLogin => SesionService.EsPantallaDeAcceso(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
    private bool isAdmin = false;
    private bool isSupervisor = false;
    private bool soloOperador = false;
    private bool isAuthenticated = false;
    private string? usuarioNombre;
    private string? usuarioRol;

    /// <summary>Las iniciales del avatar: la primera letra de las dos primeras palabras del nombre.</summary>
    private string Iniciales => string.Concat((usuarioNombre ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    protected override void OnInitialized()
    {
        // El cajón empieza abierto porque casi siempre hay sesión y así no hay saltos. En el login no: si se
        // abriera en el primer pintado y se cerrara al leer el token, al abrir o recargar /login se vería
        // un instante la franja azul vacía y la tarjeta desplazada (M-01).
        drawerOpen = !EsLogin;
    }

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticated();
        drawerOpen = isAuthenticated;
        if (isAuthenticated)
        {
            var roles = await AuthorizationService.GetUserRolesAsync();
            isAdmin = roles.Contains(RolesSistema.Administrador);
            isSupervisor = roles.Contains(RolesSistema.Supervisor);
            soloOperador = roles.Contains(RolesSistema.Operador) && !isAdmin && !isSupervisor
                           && !roles.Contains(RolesSistema.Estandar);

            // Quién tiene la sesión abierta, para la barra: su nombre y el rol de más alcance que tenga.
            usuarioNombre = await AuthorizationService.GetUserNameAsync();
            usuarioRol = new[] { RolesSistema.Administrador, RolesSistema.Supervisor, RolesSistema.Operador, RolesSistema.Estandar }
                .FirstOrDefault(roles.Contains) ?? roles.FirstOrDefault();
        }
    }

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }

    private async Task HandleLogout()
    {
        await HttpClientService.CerrarSesionAsync();
        await AuthService.ClearTokenAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
