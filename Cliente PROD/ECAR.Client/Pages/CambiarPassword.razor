@page "/cambiar-password"
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject CambioPasswordEstado Estado

@* Cambio de la contraseña de una cuenta de SGI.Identity (guía de integración §7.3). Solo se abre cuando el login
   recibió PasswordExpired o RequiresPasswordChange y el pase para cambiarla; sin él (entrada directa, recarga) se vuelve al login. Las
   reglas de la contraseña, el historial y la reutilización los valida SGI.Identity: aquí solo se muestran sus
   mensajes. No crea sesión: al terminar se vuelve a iniciar sesión con la nueva contraseña. *@

@if (Estado.EsPara(AccionesLogin.CambiarPassword))
{
    <TarjetaAcceso Titulo="Cambiar contraseña" Subtitulo="Debe cambiar su contraseña para continuar.">
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
            @(string.IsNullOrWhiteSpace(Estado.Mensaje) ? "Debe cambiar su contraseña para continuar." : Estado.Mensaje)
        </MudAlert>

        <div class="acceso-form">
            <MudTextField T="string" Label="Usuario" Value="@Estado.Usuario" ReadOnly="true" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" Class="mb-2" />

            <MudTextField T="string" Label="Contraseña actual" @bind-Value="passwordActual" Variant="Variant.Outlined"
                          InputType="InputType.Password" Immediate="true" AutoFocus="true" Disabled="@enviando"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock" Class="mb-2"
                          OnKeyDown="EnterEnvia" />

            <MudTextField T="string" Label="Nueva contraseña" @bind-Value="nuevaPassword" Variant="Variant.Outlined"
                          InputType="@(mostrar ? InputType.Text : InputType.Password)" Immediate="true" Disabled="@enviando"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(mostrar ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="@(mostrar ? "Ocultar contraseñas" : "Mostrar contraseñas")"
                          OnAdornmentClick="@(() => mostrar = !mostrar)" Class="mb-2" OnKeyDown="EnterEnvia" />

            <MudTextField T="string" Label="Confirmar nueva contraseña" @bind-Value="confirmarPassword" Variant="Variant.Outlined"
                          InputType="@(mostrar ? InputType.Text : InputType.Password)" Immediate="true" Disabled="@enviando"
                          Class="mb-2" OnKeyDown="EnterEnvia" />

            @if (enviando)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="acceso-boton"
                       StartIcon="@Icons.Material.Filled.Key" OnClick="EnviarAsync" Disabled="@(enviando || !Completo)">
                @(enviando ? "Cambiando…" : "Cambiar contraseña")
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Default" FullWidth="true" Class="acceso-boton mt-1"
                       StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="VolverAlLogin" Disabled="@enviando">
                Volver al inicio de sesión
            </MudButton>

            @if (!string.IsNullOrEmpty(error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                    <MudText Typo="Typo.body2">@error</MudText>
                    @if (errores is { Count: > 0 })
                    {
                        <ul class="mt-1 mb-0 pl-4">
                            @foreach (var detalle in errores)
                            {
                                <li><MudText Typo="Typo.body2">@detalle</MudText></li>
                            }
                        </ul>
                    }
                </MudAlert>
            }
        </div>
    </TarjetaAcceso>
}

@code {
    private string passwordActual = string.Empty;
    private string nuevaPassword = string.Empty;
    private string confirmarPassword = string.Empty;
    private bool mostrar;
    private bool enviando;
    private string? error;
    private List<string>? errores;

    private bool Completo => !string.IsNullOrEmpty(passwordActual) && !string.IsNullOrEmpty(nuevaPassword)
                             && !string.IsNullOrEmpty(confirmarPassword);

    protected override void OnInitialized()
    {
        // Solo cuando el API respondió que SGI.Identity pide cambiar la contraseña.
        if (!Estado.EsPara(AccionesLogin.CambiarPassword))
        {
            NavigationManager.NavigateTo("/login", replace: true);
        }
    }

    private async Task EnterEnvia(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !enviando && Completo)
        {
            await EnviarAsync();
        }
    }

    private async Task EnviarAsync()
    {
        if (enviando || !Completo)
        {
            return;
        }

        enviando = true;
        error = null;
        errores = null;

        var respuesta = await AuthService.CambiarPasswordAsync(new CambiarPasswordDto
        {
            Pase = Estado.Pase ?? string.Empty,
            PasswordActual = passwordActual,
            NuevaPassword = nuevaPassword,
            ConfirmarPassword = confirmarPassword
        });

        enviando = false;
        if (respuesta.Success)
        {
            var volver = Estado.ReturnUrl;
            Estado.Limpiar();
            NavigationManager.NavigateTo(DireccionLogin(Login.AvisoPasswordCambiada, volver), replace: true);
            return;
        }

        error = string.IsNullOrWhiteSpace(respuesta.Message) ? "No fue posible cambiar la contraseña." : respuesta.Message;
        errores = respuesta.Errors is { Count: > 0 } lista && !(lista.Count == 1 && lista[0] == error) ? lista : null;
        passwordActual = string.Empty;
    }

    private void VolverAlLogin()
    {
        var volver = Estado.ReturnUrl;
        Estado.Limpiar();
        NavigationManager.NavigateTo(DireccionLogin(null, volver), replace: true);
    }

    internal static string DireccionLogin(string? aviso, string? returnUrl)
    {
        var partes = new List<string>();
        if (!string.IsNullOrEmpty(aviso))
        {
            partes.Add($"aviso={Uri.EscapeDataString(aviso)}");
        }

        if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            partes.Add($"returnUrl={Uri.EscapeDataString(returnUrl)}");
        }

        return partes.Count == 0 ? "/login" : "/login?" + string.Join("&", partes);
    }
}
