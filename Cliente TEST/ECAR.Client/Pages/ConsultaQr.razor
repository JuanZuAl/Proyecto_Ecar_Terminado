@page "/equipos/qr/{Token}"
@layout EmptyLayout
@inject HttpClientService HttpClientService
@inject NavigationManager NavigationManager

<div class="qr-page">
    @if (cargando)
    {
        <div class="qr-loading">
            <MudProgressCircular Indeterminate="true" />
        </div>
    }
    else
    {
        @* Quien escanea el QR no ha pasado por el login: la marca de ECAR va aquí, arriba de la tarjeta (M-08). *@
        <div class="qr-columna">
        <img src="images/logo-ecar.png" alt="ECAR Laboratorios" class="qr-logo" />
        @if (equipo == null)
        {
        <MudCard Class="qr-card">
            <MudCardContent Class="d-flex flex-column align-center pa-6">
                <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-3">Código no encontrado</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary mt-1">
                    Este código QR no corresponde a ningún equipo registrado.
                </MudText>
            </MudCardContent>
        </MudCard>
        }
        else
        {
        <MudCard Class="qr-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@equipo.Equipo.NombreEquipo</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @equipo.Equipo.CodigoInterno
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    @* Sin sesión el API no envía la criticidad ni la ficha técnica. *@
                    @if (!string.IsNullOrEmpty(equipo.Equipo.Criticidad))
                    {
                        <MudChip T="string" Color="@CriticidadColor(equipo.Equipo.Criticidad)" Size="Size.Small">
                            @equipo.Equipo.Criticidad
                        </MudChip>
                    }
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        @if (!string.IsNullOrEmpty(equipo.Equipo.Marca))
                        {
                            <tr><td>Marca</td><td>@equipo.Equipo.Marca</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(equipo.Equipo.Modelo))
                        {
                            <tr><td>Modelo</td><td>@equipo.Equipo.Modelo</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(equipo.Equipo.CategoriaNombre))
                        {
                            <tr><td>Categoría</td><td>@equipo.Equipo.CategoriaNombre</td></tr>
                        }
                        <tr><td>Ubicación</td><td>@equipo.Equipo.UbicacionNombre</td></tr>
                    </tbody>
                </MudSimpleTable>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Checklists disponibles</MudText>

                @if (equipo.ChecklistsActivos.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Este equipo no tiene checklists activos asignados.
                    </MudAlert>
                }
                else
                {
                    long idEquipoActual = equipo.Equipo.IdEquipo;

                    @foreach (var checklist in equipo.ChecklistsActivos)
                    {
                        long idChecklistActual = checklist.IdChecklist;

                        <MudPaper Class="pa-3 mb-2" Outlined="true">
                            <div class="d-flex justify-space-between align-center">
                                <div>
                                    <MudText Typo="Typo.body1">@checklist.Nombre</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        Versión @checklist.Version
                                    </MudText>
                                </div>
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Activo</MudChip>
                            </div>
                            @* Se usa con el dedo, de pie junto al equipo: botón de ancho completo y de al menos 44 px
                               de alto (antes medía 64 × 23 px). *@
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                                       Class="mt-3" Style="min-height: 44px;" StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="@(() => IrAIniciarInspeccion(idEquipoActual, idChecklistActual))">
                                Iniciar inspección
                            </MudButton>
                        </MudPaper>
                    }
                }
            </MudCardContent>
        </MudCard>
        }
        </div>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool cargando = true;
    private ConsultaQrDto? equipo;

    // Consulta pública: no requiere sesión. Un token desconocido o un equipo inactivo devuelven 404
    protected override async Task OnInitializedAsync()
    {
        var result = await HttpClientService.GetEquipoByQrAsync(Token);
        equipo = result != null && result.Success ? result.Data : null;
        cargando = false;
    }

    private void IrAIniciarInspeccion(long idEquipo, long idChecklist)
    {
        NavigationManager.NavigateTo($"/inspecciones/iniciar?equipo={idEquipo}&checklist={idChecklist}");
    }

    private Color CriticidadColor(string? criticidad) => criticidad switch
    {
        "Alta" => Color.Error,
        "Media" => Color.Warning,
        _ => Color.Default
    };
}
