@page "/login"
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject IJSRuntime JS

@using ECAR.Shared.DTOs
@using ECAR.Client.Services
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.False" Class="login-container">
    <MudPaper Class="login-paper" Elevation="8">
        <div class="logo-section">
            <img src="images/logo-ecar.png" alt="ECAR Laboratorios" class="logo-image" />
            <MudText Typo="Typo.h4" Class="ecar-title">Laboratorios ECAR</MudText>
            <MudText Typo="Typo.body1" Class="ecar-subtitle">Sistema de Auditoría de Equipos</MudText>
        </div>

        <MudDivider Class="my-4" />

        @if (CerradaPorInactividad)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                Su sesión se cerró por inactividad. Inicie sesión de nuevo para volver a la página en la que estaba.
            </MudAlert>
        }
        else if (SesionExpirada)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                Su sesión expiró. Inicie sesión de nuevo para volver a la página en la que estaba.
            </MudAlert>
        }

        <MudForm @ref="form" Class="login-form">
            @* Immediate: el valor ya está enlazado cuando se pulsa Enter. *@
            <MudTextField T="string" Label="Correo o Usuario AD" @bind-Value="loginDto.CorreoOrUsuarioAD" Variant="Variant.Outlined" Required="false" RequiredError="El correo o usuario AD es requerido" Class="mb-3" AdornmentIcon="@Icons.Material.Filled.Email" Adornment="Adornment.Start"
                Immediate="true" OnKeyDown="EnterIniciaSesion" />
            <MudTextField T="string" Label="Contraseña" @bind-Value="loginDto.Password" Variant="Variant.Outlined" InputType="InputType.Password" Required="false" RequiredError="La contraseña es requerida" Class="mb-4" AdornmentIcon="@Icons.Material.Filled.Lock" Adornment="Adornment.Start"
                Immediate="true" OnKeyDown="EnterIniciaSesion" />

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-4" Color="Color.Primary" />
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="login-button" OnClick="HandleLogin" Disabled="@isLoading" StartIcon="@Icons.Material.Filled.Login">
                @if (isLoading)
                {
                    <MudText>Iniciando sesión...</MudText>
                }
                else
                {
                    <MudText>Iniciar Sesión</MudText>
                }
            </MudButton>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">
                    <MudText>@errorMessage</MudText>
                </MudAlert>
            }
        </MudForm>

        <MudDivider Class="my-4" />

        <div class="footer">
            <MudText Typo="Typo.caption" Class="footer-text">Sistema de Gestión de Equipos e Inspecciones v1.0</MudText>
        </div>
    </MudPaper>
</MudContainer>

<style>
/* El fondo (dos manchas suaves con los colores del logo) lo pone el layout, de borde a borde: aquí solo se
   centra la tarjeta. Antes el degradado vivía en un contenedor de 1280 px y a los lados quedaban franjas de
   otro tono. */
.login-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
}

.login-paper {
    max-width: 432px;
    width: 100%;
    padding: 2.5rem 2.25rem 2rem;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    box-shadow: var(--sombra-3);
}

.logo-section {
    text-align: center;
    margin-bottom: 0.5rem;
}

.logo-image {
    height: 112px;
    width: 112px;
    margin-bottom: 0.75rem;
}

.ecar-title {
    color: var(--titulo);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
}

.ecar-subtitle {
    color: var(--secondary);
    margin-top: 0.25rem;
    font-weight: 500;
}

.login-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.login-button {
    height: 48px;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 12px !important;
}

.footer {
    text-align: center;
}

.footer-text {
    color: var(--text-secondary);
}

@@media (max-width: 480px) {
    .login-paper {
        padding: 1.75rem 1.25rem 1.5rem;
        border-radius: 16px;
    }

    .logo-image {
        height: 96px;
        width: 96px;
    }
}
</style>

@code {
    private MudForm? form;
    private LoginDto loginDto = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    // Página a la que volver tras iniciar sesión. La usan las pantallas protegidas
    // (p. ej. ejecutar una inspección abierta desde el QR en el teléfono).
    [SupplyParameterFromQuery(Name = "returnUrl")]
    [Parameter]
    public string? ReturnUrl { get; set; }

    // La pone SesionService cuando manda aquí porque el token venció.
    [SupplyParameterFromQuery(Name = "expirada")]
    [Parameter]
    public string? Expirada { get; set; }

    private bool SesionExpirada => Expirada == "1";

    // La pone SesionService cuando cierra la sesión por inactividad (Fase 4, PLAN §3.8).
    [SupplyParameterFromQuery(Name = "inactividad")]
    [Parameter]
    public string? Inactividad { get; set; }

    private bool CerradaPorInactividad => Inactividad == "1";

    /// <summary>
    /// Destino tras iniciar sesión. Solo se acepta una ruta de esta misma aplicación: si se
    /// aceptara cualquier URL, un enlace como /login?returnUrl=https://sitio-falso pondría al
    /// usuario, recién autenticado, en una web ajena (redirección abierta).
    /// </summary>
    private const char BarraInvertida = (char)92;

    private string DestinoSeguro()
    {
        var destino = ReturnUrl?.Trim();

        // Rechaza URL absolutas ("https://…"), las relativas al protocolo ("//sitio") y las que
        // empiezan por barra invertida, que los navegadores tratan igual que "/".
        if (string.IsNullOrEmpty(destino)
            || destino.Contains("://")
            || destino.StartsWith(BarraInvertida)
            || (destino.Length > 1 && destino[0] == '/' && (destino[1] == '/' || destino[1] == BarraInvertida))
            || !Uri.TryCreate(destino, UriKind.Relative, out _))
        {
            return "/";
        }

        // Volver al propio login dejaría al usuario en un bucle.
        var ruta = destino.TrimStart('/');
        if (ruta.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            return "/";
        }

        return "/" + ruta;
    }

    private async Task EnterIniciaSesion(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !isLoading)
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginDto.CorreoOrUsuarioAD) || string.IsNullOrWhiteSpace(loginDto.Password))
        {
            errorMessage = "Por favor complete todos los campos requeridos";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            // Fase 4: el servidor dice por qué no se pudo entrar (usuario o contraseña incorrectos,
            // cuenta bloqueada con 423, etc.) y se muestra tal cual.
            var respuesta = await AuthService.LoginConMensajeAsync(loginDto);

            if (respuesta.Success && respuesta.Data is not null)
            {
                // El reloj de inactividad arranca ahora: si no, la última actividad guardada
                // podría ser de hace horas y la sesión se cerraría nada más entrar.
                try
                {
                    await JS.InvokeVoidAsync("ecarActividad.reiniciar");
                }
                catch (JSException)
                {
                    // Sin actividad.js no hay cierre por inactividad; el login sigue.
                }

                // Sin cambio de contraseña al entrar desde el 03/11/2026: lo administra una API externa.
                // Login exitoso. forceLoad recarga el layout para reflejar roles y menú.
                // Si se llegó aquí desde una página protegida, se vuelve a ella.
                NavigationManager.NavigateTo(DestinoSeguro(), forceLoad: true);
            }
            else
            {
                errorMessage = string.IsNullOrWhiteSpace(respuesta.Message)
                    ? "No se pudo iniciar sesión. Intente de nuevo."
                    : respuesta.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}